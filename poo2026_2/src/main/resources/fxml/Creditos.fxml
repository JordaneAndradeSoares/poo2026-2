<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane id="AnchorPane"
            fx:id="root"
            styleClass="mainFxmlClass"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="com.poo2026_2.controller.CreditosController">

    <stylesheets>
        <URL value="@/styles/creditos.css" />
    </stylesheets>

    <StackPane AnchorPane.topAnchor="0.0"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0">

        <!-- IMAGEM DE FUNDO -->
        <ImageView fitWidth="${root.width}"
                   fitHeight="${root.height}"
                   preserveRatio="false"
                   pickOnBounds="true"
                   smooth="true">

            <image>
                <Image url="@../images/menu/creditos.png" />
            </image>

        </ImageView>

        <!-- BOTÃO VOLTAR -->
        <Button fx:id="btnVoltar"
                onAction="#voltar"
                styleClass="botao-voltar"
                StackPane.alignment="BOTTOM_CENTER"
                translateY="-20.0" />

    </StackPane>

</AnchorPane>