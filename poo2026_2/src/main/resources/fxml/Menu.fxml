<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" styleClass="menu-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.poo2026_2.controller.MenuController">

    <stylesheets>
        <URL value="@../styles/menu.css" />
    </stylesheets>

    <!-- IMAGEM DE FUNDO -->
    <ImageView  
        fx:id="fundoDia"
        fitHeight="${root.height}" 
        fitWidth="${root.width}" 
        pickOnBounds="true" 
        preserveRatio="false">

        <image>
            <Image url="@../images/menu/menu-background.png" />
        </image>
    </ImageView>

    <!-- FUNDO NOTURNO (aparece so durante o trovao; controlado pelo MenuController) -->
    <ImageView 
        fx:id="fundoNoite" 
        fitHeight="${root.height}" 
        fitWidth="${root.width}" 
        mouseTransparent="true" 
        preserveRatio="false" 
        visible="false">
        
        <image>
            <Image url="@../images/menu/menu-background-night.png" />
        </image>
    </ImageView>

    <AnchorPane fx:id="painelBotoes" maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" pickOnBounds="false" prefHeight="720.0" prefWidth="1280.0">

        <!--
            Origem do vapor do cafe, alinhada com a borda da xicara na
            imagem de fundo (coordenadas no canvas de referencia 1280x720).
            As baforadas sao criadas e animadas em codigo (MenuController).
        -->
        <Group fx:id="vaporCafeEsquerda" layoutX="220.0" layoutY="480.0" mouseTransparent="true" />
        <Group fx:id="vaporCafeDireita" layoutX="240.0" layoutY="480.0" mouseTransparent="true" />

        <!--JOGAR -->
        <Button fx:id="btnJogar" layoutX="822.0" layoutY="113.0" onAction="#iniciarJogo" prefHeight="112.0" prefWidth="384.0" styleClass="menu-btn, menu-btn-play" />

        <!--CONFIGURAÇÕES-->
        <Button fx:id="btnConfiguracoes" layoutX="823.0" layoutY="225.0" onAction="#abrirConfiguracoes" prefHeight="112.0" prefWidth="384.0" styleClass="menu-btn, menu-btn-config" />

        <!-- CRÉDITOS -->
        <Button fx:id="btnCreditos" layoutX="823.0" layoutY="335.0" onAction="#abrirCreditos" prefHeight="112.0" prefWidth="384.0" styleClass="menu-btn, menu-btn-creditos" />

        <!-- SAIR -->
        <Button fx:id="btnSair" layoutX="822.0" layoutY="447.0" onAction="#sair" prefHeight="112.0" prefWidth="384.0" styleClass="menu-btn, menu-btn-sair" />

        <!-- Botão direto jogo
        <Button fx:id="btnJogo" layoutX="42.0" layoutY="276.0" mnemonicParsing="false" onAction="#irJogo" prefHeight="123.0" prefWidth="455.0" stylesheets="@../styles/menu.css">
            <styleClass>
                <String fx:value="menu-btn-teste" />
                <String fx:value="menu-btn" />
            </styleClass>
        </Button>
        -->

    </AnchorPane>

</StackPane>
