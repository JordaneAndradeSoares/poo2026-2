<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<!--
  Raiz: StackPane que ocupa a janela toda.
  Dentro dela, o "palco" tem tamanho FIXO (1672x941 = tamanho do background.png)
  e é escalado pelo controller para caber em qualquer resolucao 16:9.
  Assim a grade sempre fica alinhada com a imagem.
-->

<StackPane fx:id="raiz" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.poo2026_2.controller.JogoController">

    <stylesheets>
        <URL value="@../styles/jogo.css" />
    </stylesheets>

    <Pane
        fx:id="palco"
        maxHeight="941" maxWidth="1672"
        minHeight="941" minWidth="1672"
        prefHeight="941" prefWidth="1672">

        <!-- Imagem de fundo -->
        <ImageView fitHeight="941" fitWidth="1672" preserveRatio="false">
            <image>
                <Image url="@../images/game/background2.png"/>
            </image>
        </ImageView>

        <!-- Grade -->
        <GridPane fx:id="grade">
            <styleClass>
                <String fx:value="grade"/>
                <String fx:value="pane"/>
            </styleClass>
        </GridPane>

        <Pane
            fx:id="camadaJogo"
            layoutX="0"
            layoutY="0"
            prefWidth="1672"
            prefHeight="941"
            mouseTransparent="true"
        />

        <VBox
            spacing="10"
            layoutX="10"
            layoutY="10"
            pickOnBounds="false">

            <HBox
                spacing="10"
                alignment="TOP_LEFT"
                pickOnBounds="false">

                <!-- Botões de seleção dos personagens -->
                <Button fx:id="btnCafeteira" text="Cafeteira"
                        onAction="#selecionarCafeteira"/>

                <Button fx:id="btnDaniel" text="Daniel"
                        onAction="#selecionarDaniel"/>

                <Button fx:id="btnFabricio" text="Fabrício"
                        onAction="#selecionarFabricio"/>

                <Button fx:id="btnGlaucia" text="Gláucia"
                        onAction="#selecionarGlaucia"/>

                <Button fx:id="btnLucas" text="Lucas"
                        onAction="#selecionarLucas"/>

                <Button fx:id="btnMarcus" text="Marcus"
                        onAction="#selecionarMarcus"/>

                <Button fx:id="btnNacif" text="Nacif"
                        onAction="#selecionarNacif"/>

                <Button fx:id="btnPhilipe" text="Philipe"
                        onAction="#selecionarPhilipe"/>

                <Button fx:id="btnThais" text="Thaís"
                        onAction="#selecionarThais"/>

            </HBox>

            <!-- Indicador da quantidade de café disponível -->
            <HBox 
                prefWidth="300"
                prefHeight="60"
                
                maxWidth="300"
                maxHeight="60"

                alignment="CENTER_LEFT"
                mouseTransparent="true"
                styleClass="painel-cafe">

                <ImageView 
                    fitWidth="100"
                    fitHeight="100"
                    preserveRatio="true">

                    <image>
                        <Image url="@/images/interface/xicara.png"/>
                    </image>
                </ImageView>

                <Label 
                    fx:id="lblCafe"
                    styleClass="texto-cafe"/>
            </HBox>

            <!-- Botão Voltar -->
            <Button fx:id="btnVoltar"
                    prefHeight="62" 
                    prefWidth="200"
                    mnemonicParsing="false"
                    onAction="#voltar"
                    styleClass="botao-voltar"
                    stylesheets="@../styles/jogo.css"
                    text="voltar"/>

        </VBox>
    </Pane>

    <!-- Tela de resultado do jogo (vitoria ou derrota) -->
    <StackPane
        fx:id="camadaResultado"
        visible="false"
        prefWidth="1672"
        prefHeight="941"
        minWidth="0"
        minHeight="0"
        maxWidth="Infinity"
        maxHeight="Infinity"
        alignment="CENTER"
        style="-fx-background-color: rgba(0, 0, 0, 0.65);">

        <VBox
            alignment="CENTER"
            spacing="15.0"
            fillWidth="false">
            
            <!-- Imagem da vitória -->
            <ImageView
                fx:id="imagemVitoria"
                fitWidth="700"
                fitHeight="600"
                preserveRatio="true"
                visible="false"
                managed="false"
                mouseTransparent="true">

                <image>
                    <Image url="@../images/telas/vitoria.png"/>
                </image>
            </ImageView>

            <!-- Imagem da derrota -->
            <ImageView 
                fx:id="imagemDerrota"
                fitWidth="700"
                fitHeight="600"
                preserveRatio="true"
                visible="false"
                managed="false"
                mouseTransparent="true">

                <image>
                    <Image url="@../images/telas/derrota.png"/>
                </image>
            </ImageView>

            <!-- Botão jogar novamente -->
            <Button fx:id="btnJogarNovamente"
                    prefHeight="60" 
                    prefWidth="200"
                    mnemonicParsing="false"
                    onAction="#jogarNovamente"
                    styleClass="jogar-novamente"
                    stylesheets="@../styles/jogo.css"
                    text="Jogar novamente"/>

            <!-- Botão Voltar -->
            <Button fx:id="btnVoltar"
                    prefHeight="40" 
                    prefWidth="110"
                    mnemonicParsing="false"
                    onAction="#voltar"
                    styleClass="botao-voltar"
                    stylesheets="@../styles/jogo.css"
                    text="Voltar"/>

        </VBox>

    </StackPane>

</StackPane>