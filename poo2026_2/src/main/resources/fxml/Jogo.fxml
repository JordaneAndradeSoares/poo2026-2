<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.VBox?>

<!--
  O "palco" tem tamanho FIXO (1920x1080 = fundo-game.png) e é escalado pelo
  controller para caber na janela. Assim a grade sempre alinha com o fundo.
  Tudo que depende da fase (cards, casas, saídas) é montado no controller.
-->
<StackPane fx:id="raiz" styleClass="jogo-raiz"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.poo2026_2.controller.JogoController">

    <stylesheets>
        <URL value="@../styles/jogo.css" />
    </stylesheets>

    <Pane fx:id="palco"
          minWidth="1920" maxWidth="1920" prefWidth="1920"
          minHeight="1080" maxHeight="1080" prefHeight="1080">

        <!-- Fundo: barra de cima (com a xícara) + tabuleiro xadrez -->
        <ImageView fitWidth="1920" fitHeight="1080" preserveRatio="false" mouseTransparent="true">
            <image>
                <Image url="@../images/game/fundo-game.png"/>
            </image>
        </ImageView>

        <!-- Porta de saída + carrinho de cada linha -->
        <Pane fx:id="faixaSaidas" layoutX="0" layoutY="190"
              prefWidth="203" prefHeight="890" mouseTransparent="true"/>

        <!-- Casas clicáveis (transparentes), alinhadas com o fundo -->
        <GridPane fx:id="grade" layoutX="203" layoutY="190"/>

        <!-- Zumbis e tiros (por cima das casas, não recebe clique) -->
        <Pane fx:id="camadaAcao" layoutX="203" layoutY="190"
              prefWidth="1600" prefHeight="890" mouseTransparent="true"/>

        <!-- Quantidade de café, embaixo da xícara do fundo -->
        <Label fx:id="lblCafe" styleClass="texto-cafe"
               layoutX="0" layoutY="106" prefWidth="203" alignment="CENTER"
               mouseTransparent="true"/>

        <!-- Cards dos personagens -->
        <HBox fx:id="cartoes" layoutX="210" layoutY="17" spacing="24"
              alignment="TOP_LEFT" pickOnBounds="false"/>

        <!-- Linha do tempo da fase + velocidade do jogo (canto inferior direito; montada pelo controller) -->
        <Pane fx:id="camadaLinhaDoTempo" layoutX="1380" layoutY="962"
              prefWidth="520" prefHeight="112" pickOnBounds="false"/>

        <!-- Botoes redondos (a direita da barra de cards): voltar, configuracoes, pausar -->
<Button fx:id="btnVoltar" styleClass="botao-redondo" layoutX="1834.0" layoutY="14.0"
        prefWidth="48.0" prefHeight="48.0" minWidth="48.0" minHeight="48.0" maxWidth="48.0" maxHeight="48.0"
        onAction="#aoClicarVoltar" focusTraversable="false" mnemonicParsing="false">
    <graphic>
        <SVGPath styleClass="botao-redondo-icone" scaleX="1.4" scaleY="1.4"
                 content="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
    </graphic>
</Button>

            <Button fx:id="btnConfig" styleClass="botao-redondo" layoutX="1834.0" layoutY="71.0"
                  prefWidth="48.0" prefHeight="48.0" minWidth="48.0" minHeight="48.0" maxWidth="48.0" maxHeight="48.0"
                  onAction="#aoClicarConfig" focusTraversable="false" mnemonicParsing="false">
            <graphic>
                  <SVGPath styleClass="botao-redondo-icone" scaleX="1.4" scaleY="1.4"
                        content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
            </graphic>
            </Button>

            <Button fx:id="btnPausar" styleClass="botao-redondo" layoutX="1834.0" layoutY="128.0"
                  prefWidth="48.0" prefHeight="48.0" minWidth="48.0" minHeight="48.0" maxWidth="48.0" maxHeight="48.0"
                  onAction="#aoClicarPausar" focusTraversable="false" mnemonicParsing="false">
            <graphic>
                  <SVGPath fx:id="iconePausar" styleClass="botao-redondo-icone" scaleX="1.4" scaleY="1.4"
                        content="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
            </graphic>
            </Button>

            <StackPane  fx:id="camadaResultado"
                        layoutX="0" layoutY="0"
                        prefWidth="1920" prefHeight="1080"
                        visible="false"
                        alignment="CENTER"
                        styleClass="camada-resultado">

                  <!-- VITÓRIA PADRÃO -->
                  <VBox fx:id="painelVitoriaPadrao"
                        styleClass="painel-vitoria-padrao"
                        alignment="CENTER_LEFT"
                        spacing="25"
                        visible="false"
                        managed="false"
                        StackPane.alignment="CENTER_LEFT"
                        translateX="140">

                        <VBox spacing="12">
                              <Label fx:id="lblTerminalTexto"
                                    styleClass="texto-terminal"
                                    text=""/>

                              <Label fx:id="lblMensagemResultado"
                                    styleClass="texto-terminal"
                                    text=""/>
                        </VBox>

                        <VBox spacing="18" alignment="CENTER_LEFT">

                              <Button fx:id="btnJogarNovamente"
                                    text="Jogar novamente"
                                    styleClass="botao-terminal"
                                    visible="false"
                                    managed="false"
                                    onAction="#jogarNovamente"/>

                              <Button fx:id="btnProximaFase"
                                    text="Próxima fase"
                                    styleClass="botao-terminal"
                                    visible="false"
                                    managed="false"
                                    onAction="#proximaFase"/>

                              <Button fx:id="btnVoltarResultado"
                                    text="Voltar"
                                    styleClass="botao-terminal"
                                    visible="false"
                                    managed="false"
                                    onAction="#voltarDoResultado"/>

                        </VBox>

                  </VBox>

                  <!-- VITÓRIA FINAL -->
                  <VBox fx:id="painelVitoriaFinal"
                        styleClass="painel-vitoria"
                        alignment="CENTER"
                        spacing="35"
                        visible="false"
                        managed="false">
                        
                        <Label text="JOGO TERMINADO!"
                              styleClass="mensagem-vitoria"/>

                        <Button fx:id="btnJogarNovamenteFinal"
                              text="JOGAR NOVAMENTE"
                              styleClass="jogar-novamente-final"
                              onAction="#jogarNovamente"/>

                        <Button fx:id="btnVoltarFinal"
                              text="VOLTAR AO MENU"
                              styleClass="voltar-final"
                              onAction="#voltarDoResultado"/>

                  </VBox>

                  <!-- TELA DE DERROTA -->
                  <VBox fx:id="painelDerrota"
                        styleClass="painel-derrota"
                        alignment="CENTER_LEFT"
                        spacing="28"
                        visible="false"
                        managed="false"
                        StackPane.alignment="CENTER_LEFT"
                        translateX="150">

                        <!-- Carinha triste -->
                        <Label fx:id="lblRostoDerrota"
                              text=":("
                              styleClass="rosto-derrota"/>

                        <!-- Título -->
                        <Label fx:id="lblTituloDerrota"
                              text="DERROTA!"
                              styleClass="titulo-derrota"/>

                        <!-- Mensagem -->
                        <Label fx:id="lblMensagemDerrota"
                              text="MAS VOCÊ AINDA PODE TENTAR NOVAMENTE!"
                              styleClass="mensagem-derrota"
                              wrapText="true"/>

                        <!-- QR Code e botões lado a lado -->
                        <HBox alignment="CENTER_LEFT" spacing="55">

                              <ImageView fx:id="imagemQRCodeDerrota"
                                          fitWidth="300"
                                          fitHeight="300"
                                          preserveRatio="true">
                                    <image>
                                          <Image url="@../images/game/itens/QRCode.png"/>
                                    </image>
                              </ImageView>

                              <VBox alignment="CENTER_LEFT" spacing="28">

                                    <Button fx:id="btnJogarNovamenteDerrota"
                                          text="Jogar novamente"
                                          styleClass="botao-derrota botao-derrota-largo"
                                          onAction="#jogarNovamente"/>

                                    <Button fx:id="btnVoltarDerrota"
                                          text="Voltar"
                                          styleClass="botao-derrota botao-derrota-curto"
                                          onAction="#voltarDoResultado"/>

                              </VBox>

                        </HBox>

                  </VBox>
                  
                  <!-- CONFETES -->
                  <Pane fx:id="camadaConfetes"
                        prefWidth="1920"
                        prefHeight="1080"
                        mouseTransparent="true"/>

            </StackPane>
    </Pane>
</StackPane>
