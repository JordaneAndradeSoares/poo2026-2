<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<!--
  Raiz: StackPane que ocupa a janela toda.
  Dentro dela, o "palco" tem tamanho FIXO (1672x941 = tamanho do background.png)
  e é escalado pelo controller para caber em qualquer resolucao 16:9.
  Assim a grade sempre fica alinhada com a imagem.
-->

<StackPane fx:id="raiz" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.poo2026_2.controller.JogoController">

    <stylesheets>
        <URL value="@../styles/jogo.css" />
    </stylesheets>

    <Pane
        fx:id="palco"
        maxHeight="941" maxWidth="1672"
        minHeight="941" minWidth="1672"
        prefHeight="941" prefWidth="1672">

        <!-- Imagem de fundo -->
        <ImageView fitHeight="941" fitWidth="1672" preserveRatio="false">
            <image>
                <Image url="@../images/game/background2.png"/>
            </image>
        </ImageView>

        <!-- Grade -->
        <GridPane fx:id="grade">
            <styleClass>
                <String fx:value="grade"/>
                <String fx:value="pane"/>
            </styleClass>
        </GridPane>

        <Pane
            fx:id="camadaJogo"
            layoutX="0"
            layoutY="0"
            prefWidth="1672"
            prefHeight="941"
            mouseTransparent="true"
        />

        <!-- Indicador de café disponível -->
        <Label 
            fx:id="lblCafe"
            layoutX="20"
            layoutY="30"
            text="Café: 150"
            
            style = 
                "-fx-background-color: yellow;
                -fx-text-fill: black;
                -fx-font-size: 24px;
                -fx-font-weight: bold;
                -fx-padding: 10 18 10 18;
                -fx-background-radius: 10;"/>

        <!-- Seleção dos personagens -->
        <VBox
            layoutX="20"
            layoutY="180"
            spacing="10"
            prefHeight="400.0"
            prefWidth="150.0"
            alignment="CENTER">

            <Button fx:id="btnCafeteira" prefWidth="300" text="Cafeteira"
                    onAction="#selecionarCafeteira"/>

            <Button fx:id="btnDaniel" prefWidth="300" text="Daniel"
                    onAction="#selecionarDaniel"/>

            <Button fx:id="btnFabricio" prefWidth="300" text="Fabrício"
                    onAction="#selecionarFabricio"/>

            <Button fx:id="btnGlaucia" prefWidth="300" text="Gláucia"
                    onAction="#selecionarGlaucia"/>

            <Button fx:id="btnLucas" prefWidth="300" text="Lucas"
                    onAction="#selecionarLucas"/>

            <Button fx:id="btnMarcus" prefWidth="300" text="Marcus"
                    onAction="#selecionarMarcus"/>

            <Button fx:id="btnNacif" prefWidth="300" text="Nacif"
                    onAction="#selecionarNacif"/>

            <Button fx:id="btnPhilipe" prefWidth="300" text="Philipe"
                    onAction="#selecionarPhilipe"/>

            <Button fx:id="btnThais" prefWidth="300" text="Thaís"
                    onAction="#selecionarThais"/>

        </VBox>

        <!-- Botão Voltar -->
        <Button fx:id="btnVoltar"
                layoutX="1132" layoutY="90"
                prefHeight="62" prefWidth="200"
                mnemonicParsing="false"
                onAction="#voltar"
                styleClass="botao-voltar"
                stylesheets="@../styles/jogo.css"
                text="voltar"/>

    </Pane>

    <!-- Tela de resultado do jogo (vitoria ou derrota) -->
    <StackPane
        fx:id="camadaResultado"
        prefWidth="1672"
        prefHeight="941"
        visible="false"
        maxWidth="Infinity"
        maxHeight="Infinity"
        alignment="CENTER"
        style="-fx-background-color: rgba(0, 0, 0, 0.55);">

        <!-- Imagem da vitória -->
        <ImageView
            fx:id="imagemVitoria"
            fitWidth="700"
            fitHeight="600"
            preserveRatio="true"
            visible="false"
            mouseTransparent="true">

            <image>
                <Image url="@../images/telas/vitoria.png"/>
            </image>
        </ImageView>

        <!-- Imagem da derrota -->
        <ImageView 
            fx:id="imagemDerrota"
            fitWidth="700"
            fitHeight="600"
            preserveRatio="true"
            visible="false"
            mouseTransparent="true">

            <image>
                <Image url="@../images/telas/derrota.png"/>
            </image>
        </ImageView>

        <!-- Botões da tela final -->
        <VBox alignment="CENTER" spacing="15" translateY="200">
            <Button text="Jogar novamente" onAction="#jogarNovamente"/>
            <Button text="Voltar ao menu" onAction="#voltar"/>
        </VBox>

    </StackPane>

</StackPane>