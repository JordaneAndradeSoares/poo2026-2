<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.poo2026_2.controller.SelecaoProfessorController">
    <stylesheets>
        <URL value="@/styles/selecaoprofessor.css"/>
    </stylesheets>

    <!-- Label com ID e texto inicial -->
    <Label fx:id="lblMensagem" text="Escolha um professor" />

    <VBox spacing="10">
        <children>

            <!-- Botão da cafeteira -->
            <Button fx:id="CafeteiraBotao" text="Cafeteira" onAction="#selecionarCafeteira" />

            <!-- Botão do Daniel -->
            <Button fx:id="DanielBotao" text="Daniel" onAction="#selecionarDaniel"/>

            <!-- Botão do Fabricio -->
            <Button fx:id="FabricioBotao" text="Fabrício" onAction="#selecionarFabricio" />
        </children>
    </VBox>

</AnchorPane>
